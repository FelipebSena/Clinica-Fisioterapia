        <mxCell id="CYloJ8aktidzVZUnKdqv-298" parent="CYloJ8aktidzVZUnKdqv-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;strong&gt;Especialização total e exclusiva (disjunta):&lt;/strong&gt; todo Profissional é exatamente um Fisioterapeuta ou um Estagiário." vertex="1">
