        </mxCell>
        <mxCell id="CYloJ8aktidzVZUnKdqv-314" parent="CYloJ8aktidzVZUnKdqv-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Quando preenchida, &lt;code&gt;data_alta&lt;/code&gt; não pode ser anterior a &lt;code&gt;data_inicio&lt;/code&gt;. Um paciente não pode ter dois tratamentos em andamento na mesma especialidade." vertex="1">
          <mxGeometry height="30" width="293.5" x="1250" y="810" as="geometry" />
        </mxCell>
        <mxCell id="CYloJ8aktidzVZUnKdqv-315" parent="CYloJ8aktidzVZUnKdqv-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Duas sessões não podem ocupar a mesma sala no mesmo horário — RN17." vertex="1">
          <mxGeometry height="30" width="145" x="746" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="CYloJ8aktidzVZUnKdqv-316" parent="CYloJ8aktidzVZUnKdqv-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&amp;nbsp;Não pode haver duas avaliações do mesmo paciente na mesma data." vertex="1">
          <mxGeometry height="30" width="200" x="80" y="710" as="geometry" />
        </mxCell>
        <mxCell id="CYloJ8aktidzVZUnKdqv-317" parent="CYloJ8aktidzVZUnKdqv-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;strong&gt;SESSÃO é entidade fraca:&lt;/strong&gt; depende de TRATAMENTO para existir e é identificada pela combinação &lt;code&gt;(id_tratamento, numero_sessao)&lt;/code&gt;. &lt;code&gt;numero_sessao&lt;/code&gt; é único apenas dentro de cada tratamento." vertex="1">
          <mxGeometry height="30" width="307" x="1000" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="CYloJ8aktidzVZUnKdqv-320" parent="CYloJ8aktidzVZUnKdqv-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="EVOLUÇÃO depende de SESSÃO: não existe evolução sem a sessão que a originou." vertex="1">
          <mxGeometry height="30" width="145" x="740" y="1550" as="geometry" />
        </mxCell>
