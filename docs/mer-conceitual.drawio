<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="-jbzHBw8YedjXLoGmqwM">
    <mxGraphModel dx="1845" dy="1268" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% ============================================================\n    %% MER CONCEITUAL — CLINICA DE FISIOTERAPIA\n    %% Legenda de cardinalidade Mermaid:\n    %% || = exatamente 1; o| = zero ou 1; |{ = um ou muitos; o{ = zero ou muitos\n    %% ============================================================\n\n    CONVENIO o|--o{ PACIENTE : \&quot;possui / e utilizado por (RN03)\&quot;\n\n    PACIENTE ||--o{ TRATAMENTO : \&quot;possui / realiza (RN10)\&quot;\n    FISIOTERAPEUTA ||--o{ TRATAMENTO : \&quot;e responsavel por (RN10)\&quot;\n    ESPECIALIDADE ||--o{ TRATAMENTO : \&quot;classifica / e associada a (RN10)\&quot;\n\n    TRATAMENTO ||--o{ SESSAO : \&quot;possui / pertence a - identificador (RN15)\&quot;\n    SALA ||--o{ SESSAO : \&quot;recebe / ocupa (RN16, RN17)\&quot;\n    SESSAO ||--o| EVOLUCAO : \&quot;gera / registra (RN19)\&quot;\n\n    PACIENTE ||--o{ AVALIACAO_FISICA : \&quot;possui historico de (RN22)\&quot;\n\n    PROFISSIONAL ||--o{ HABILITACAO_PROFISSIONAL : \&quot;possui habilitacao\&quot;\n    ESPECIALIDADE ||--o{ HABILITACAO_PROFISSIONAL : \&quot;e vinculada a\&quot;\n\n    SESSAO ||--o{ APLICACAO_EXERCICIO : \&quot;registra aplicacao\&quot;\n    EXERCICIO ||--o{ APLICACAO_EXERCICIO : \&quot;e aplicado em\&quot;\n\n    %% Especializacao: todo Profissional pertence a exatamente um subtipo.\n    %% A semantica de totalidade e exclusividade e complementada pela nota abaixo.\n    PROFISSIONAL ||--o| FISIOTERAPEUTA : \&quot;especializa-se em\&quot;\n    PROFISSIONAL ||--o| ESTAGIARIO : \&quot;especializa-se em\&quot;\n\n    %% Autorrelacionamento: supervisor = fisioterapeuta; supervisionado = estagiario.\n    FISIOTERAPEUTA o|--o{ ESTAGIARIO : \&quot;supervisiona (RN07)\&quot;\n\n    CONVENIO {\n        int id_convenio PK\n        string nome UK \&quot;RN24 - unico e obrigatorio\&quot;\n    }\n\n    PACIENTE {\n        int id_paciente PK\n        string cpf UK \&quot;RN01 - unico\&quot;\n        string nome\n        date data_nascimento \&quot;RN02 - obrigatoria e nao futura\&quot;\n        string telefone \&quot;opcional\&quot;\n        string situacao \&quot;RN04 - ATIVO ou INATIVO; padrao ATIVO\&quot;\n    }\n\n    PROFISSIONAL {\n        int id_profissional PK\n        string nome\n        string cpf\n        string telefone \&quot;opcional\&quot;\n        string email \&quot;opcional\&quot;\n    }\n\n    FISIOTERAPEUTA {\n        int id_profissional PK_FK \&quot;herdado de PROFISSIONAL\&quot;\n        string crefito UK \&quot;RN06 - obrigatorio e unico\&quot;\n    }\n\n    ESTAGIARIO {\n        int id_profissional PK_FK \&quot;herdado de PROFISSIONAL\&quot;\n        string instituicao_ensino\n    }\n\n    ESPECIALIDADE {\n        int id_especialidade PK\n        string nome\n        string descricao \&quot;opcional\&quot;\n    }\n\n    HABILITACAO_PROFISSIONAL {\n        int id_profissional PK_FK\n        int id_especialidade PK_FK\n        date data_habilitacao \&quot;RN08\&quot;\n    }\n\n    TRATAMENTO {\n        int id_tratamento PK\n        string descricao_condicao\n        date data_inicio \&quot;RN11 - obrigatoria\&quot;\n        date data_alta \&quot;RN11 e RN12 - opcional; nao anterior ao inicio\&quot;\n    }\n\n    SESSAO {\n        int id_tratamento PK_FK \&quot;entidade fraca - identificador do tratamento\&quot;\n        int numero_sessao PK \&quot;chave parcial; sequencial por tratamento - RN15\&quot;\n        datetime data_hora \&quot;RN16 - obrigatoria\&quot;\n        string situacao \&quot;RN18 - AGENDADA, REALIZADA, CANCELADA ou FALTA\&quot;\n    }\n\n    SALA {\n        int id_sala PK\n        string codigo UK \&quot;RN25 - unico\&quot;\n        int capacidade \&quot;RN25 - obrigatoria\&quot;\n    }\n\n    EVOLUCAO {\n        int id_tratamento PK_FK \&quot;identificada pela SESSAO\&quot;\n        int numero_sessao PK_FK \&quot;identificada pela SESSAO\&quot;\n        string conduta_aplicada\n        string resposta_observada\n    }\n\n    EXERCICIO {\n        int id_exercicio PK\n        string nome UK \&quot;RN26 - unico\&quot;\n        string regiao_corpo \&quot;RN26 - obrigatoria\&quot;\n        string descricao \&quot;opcional\&quot;\n    }\n\n    APLICACAO_EXERCICIO {\n        int id_tratamento PK_FK\n        int numero_sessao PK_FK\n        int id_exercicio PK_FK\n        int series\n        int repeticoes\n        decimal carga \&quot;RN21 - maior ou igual a zero\&quot;\n    }\n\n    AVALIACAO_FISICA {\n        int id_avaliacao PK\n        date data_avaliacao \&quot;RN22 - unica por paciente na mesma data\&quot;\n        int nivel_dor \&quot;RN23 - inteiro entre 0 e 10\&quot;\n        string amplitude_movimento \&quot;opcional\&quot;\n        string observacoes \&quot;opcional\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CYloJ8aktidzVZUnKdqv-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
